# Copy this file to .env for local/manual runs (`.env` is gitignored).
# For the scheduled GitHub Actions runs, these same names go into
# Settings -> Secrets and variables -> Actions instead — never commit real
# values here or anywhere else in this repo.

# --- ARMS login (fetch_and_push.py) ---
ARMS_USERNAME=
ARMS_PASSWORD=
ARMS_BASE_URL=
# ARMS_LOGIN_URL=   # optional, only if login isn't at ARMS_BASE_URL directly

# --- Supabase (fetch_and_push.py + fetch_calendar.py) ---
# Service-role (secret) key — Settings -> API in Supabase. NOT the
# publishable key already in ../js/config.js. Bypasses RLS: never expose
# this to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Calendars (fetch_calendar.py) ---
# GOOGLE_CALENDAR_SA_JSON: paste the ENTIRE contents of the service account
# JSON key file as one line (no file of this in the repo, ever). Each
# calendar's owner must share it with that service account's email,
# view-only ("See all event details").
# CALENDAR_IDS: comma-separated Calendar IDs to pull from (Google Calendar
# -> that calendar's settings -> Integrate calendar -> Calendar ID — not
# the iCal URL). Leave blank to instead auto-pull every calendar currently
# shared with the service account.
GOOGLE_CALENDAR_SA_JSON=
CALENDAR_IDS=

HEADLESS=true
