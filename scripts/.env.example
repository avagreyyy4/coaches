# Copy this file to .env for local/manual runs (`.env` is gitignored).
# For the scheduled GitHub Actions runs, these same names go into
# Settings -> Secrets and variables -> Actions instead — never commit real
# values here or anywhere else in this repo.

# --- ARMS login (fetch_and_push.py) ---
ARMS_USERNAME=
ARMS_PASSWORD=
ARMS_BASE_URL=
# ARMS_LOGIN_URL=   # optional, only if login isn't at ARMS_BASE_URL directly

# --- Supabase (fetch_and_push.py + fetch_calendar.py + import_players.py) ---
# Service-role (secret) key — Settings -> API in Supabase. NOT the
# publishable key already in ../js/config.js. Bypasses RLS: never expose
# this to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — Settings -> Database -> Connection string
# (use the "Session pooler" URI) in Supabase, with the real database
# password (not any API key) substituted in for [YOUR-PASSWORD]. Used only
# by scripts that need to run DDL (CREATE TABLE/policies) — the REST API
# above can't do that. Just as sensitive as the service-role key: never
# expose this to the frontend, never commit it.
DATABASE_URL=

# --- Calendars (fetch_calendar.py) ---
# Each calendar (Staff, WBB) can be wired up either way — iCal URL is
# preferred since it works from any Google account regardless of domain
# sharing policy:
#
# FOO_CALENDAR_ICAL_URL (preferred): that calendar's Settings -> "Integrate
# calendar" -> "Secret address in iCal format". A private read-only feed
# link — no sharing/admin setup needed, just paste it here.
#
# FOO_CALENDAR_ID + GOOGLE_CALENDAR_SA_JSON (fallback): GOOGLE_CALENDAR_SA_JSON
# is the ENTIRE contents of the service account JSON key file as one line
# (no file of this in the repo, ever). FOO_CALENDAR_ID is that calendar's
# Calendar ID (Settings -> Integrate calendar -> Calendar ID — not the iCal
# URL). The calendar owner must share it with the service account's email,
# view-only ("See all event details") — needs Calendar API access and,
# for accounts outside the calendar's Workspace domain, a sharing policy
# that allows it.
#
# Add more labels the same way if more calendars get added later (also add
# them to CALENDAR_LABELS in fetch_calendar.py).
GOOGLE_CALENDAR_SA_JSON=
STAFF_CALENDAR_ID=
WBB_CALENDAR_ID=
STAFF_CALENDAR_ICAL_URL=
WBB_CALENDAR_ICAL_URL=

HEADLESS=true
